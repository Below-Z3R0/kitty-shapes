{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/emblem/current.png",
    "width": 40
  },
  "display": {
    "color": {
      "keys": "#ebbcba",
      "title": "#9ccfd8"
    },
    "key": {
      "width": 0
    },
    "separator": "  ",
    "percent": {
      "type": 9,
      "color": {
        "green": "#31748f",
        "yellow": "#e99996",
        "red": "#eb6f92"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[1;38;2;224;222;244m{user-name}\u001b[0m\u001b[38;2;144;140;170m @ \u001b[0m\u001b[1;38;2;224;222;244m{host-name}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;235;194;186m■\u001b[0m \u001b[38;2;144;140;170mb3l0wz3r0 · CachyOS\u001b[0m"
    },
    "break",
    {
      "type": "command",
      "key": "OS",
      "text": "echo \"CachyOS\""
    },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "memory", "key": "MEM" },
    {
      "type": "command",
      "key": "WM",
      "text": "echo \"umbriel\""
    },
    {
      "type": "terminal",
      "key": "TERM"
    }
  ]
}
